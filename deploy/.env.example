# Copy to deploy/.env on the server and fill in:   cp .env.example .env && nano .env
# Never put this file on GitHub (it is ignored by git).

# Website login. Required before the site is reachable from the internet.
TU_PASSWORD=

# Reads and scores the news. Free key from https://aistudio.google.com
GEMINI_API_KEY=

# Only for the public HTTPS setup: your free domain, e.g. mytrader.duckdns.org
DOMAIN=

# Optional
TU_USDT_INR=88
CRYPTOPANIC_TOKEN=
NEWSAPI_KEY=
# Later, for Binance's fake-money testnet:
BINANCE_API_KEY=
BINANCE_API_SECRET=
